{
  "name": "recall",
  "private": true,
  "version": "0.1.0",
  "description": "A personal learning workspace for active recall, spaced repetition, and reflection.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
